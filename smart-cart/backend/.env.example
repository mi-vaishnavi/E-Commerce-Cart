PORT=5000
CORS_ORIGIN=http://localhost:5173

# postgres (default) or memory (non-persistent fallback for UI testing)
DB_MODE=postgres
# If PostgreSQL is unreachable at startup, switch to the in-memory store instead of exiting
ALLOW_MEMORY_FALLBACK=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_cart

# Tax applied to (subtotal - discount). Set 0 to disable.
TAX_RATE_PERCENT=5
